<!DOCTYPE html>

<html>

    <head>
        <title>Cadastro_post</title>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="blog.css">
    </head>
    <body>
        <h1 #inicio>Bem vindo ao blog!</h1>
        <form action="/cadastrar_post" method="get">
            <button type="submit">Cria post</button>
        </form>
        <% for(var i =0;i < items.length;i++){ %>
            <div class="post">
                <h1><%= items[i].db_titulo %></h1>
                <h3><%= items[i].db_resumo %></h3>
                <h3><%= items[i].db_conteudo %></h3>
            </div>
        <% }; %>

    </body>